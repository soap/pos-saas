{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "types": ["vite/client"],
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "noEmit": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": true,
        "skipLibCheck": true,
        "jsx": "preserve",
        "paths": {
            "@pos/*": ["./resources/js/pos/*"]
        }
    },
    "include": ["resources/js/pos/**/*.ts", "resources/js/pos/**/*.vue"]
}
